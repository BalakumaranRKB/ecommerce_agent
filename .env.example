# Copy this file to .env and fill in the key for the provider you use.
#
# LLM_PROVIDER selects the backend: "anthropic" (default) or "groq".
# You only need the API key for the provider you select.
#
# Anthropic is the default for Assignment 2: tool-calling is more reliable, which
# matters once the eval starts scoring trajectories rather than answer text — a
# provider that intermittently skips a tool call shows up as eval noise, not as a
# real regression. Groq stays available for cheap iteration.

LLM_PROVIDER=anthropic

GROQ_API_KEY=your-key-here
ANTHROPIC_API_KEY=your-key-here


# ---------------------------------------------------------------- database --
# Postgres + pgvector. Retrieval, the mock order/account tables, and prior-ticket
# history all live here from Stage 2 onward.
#
# Locally these match docker-compose.dev.yml. In CI they point at the service
# container. On AWS they point at RDS and come from SSM Parameter Store, never
# from a committed file. DB_HOST is the only value that differs between the three.

# DB_PORT is the HOST-side port only. The container, the CI service container,
# and RDS all listen on 5432 internally — this just says where to reach the
# local one from your machine. If something else already occupies 5432 (a conda
# `postgresql` package or a Windows Postgres service will take it silently, and
# the symptom is a confusing "password authentication failed" against a server
# you never configured), set 5433 here and recreate the container. Check with:
#   netstat -ano | findstr :5432       # more than one PID = conflict
# This is a laptop-only quirk; CI and AWS both use 5432.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ordercare
DB_USER=ordercare
DB_PASSWORD=ordercare_dev


# ----------------------------------------------------------------- tracing --
# LangFuse. Create a project, then copy its two keys here.
#
# LANGFUSE_HOST must match the region your project lives in — check the URL in
# your browser. Pointing at the wrong region fails auth silently rather than
# raising a clear error, which is an annoying half-hour to debug.
#   Cloud (US):   https://us.cloud.langfuse.com
#   Cloud (EU):   https://cloud.langfuse.com
#   Self-hosted:  http://localhost:3000
#
# Leaving these blank is fine and intentional — tracing degrades to a no-op so
# the agent still runs in CI, where there is no LangFuse instance to talk to.

LANGFUSE_PUBLIC_KEY=pk-lf-your-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-key-here
LANGFUSE_HOST=https://us.cloud.langfuse.com
